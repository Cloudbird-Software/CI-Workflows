{
  "$schema": "http://json-schema.org/draft-07/schema#",
  "title": "test-order",
  "type": "object",
  "required": ["id", "quantity", "label"],
  "properties": {
    "id": {"type": "string", "minLength": 3, "maxLength": 10},
    "quantity": {"type": "integer", "minimum": 1, "maximum": 100},
    "label": {"type": "string", "enum": ["alpha", "beta", "gamma"]},
    "tags": {"type": "array", "minItems": 1, "maxItems": 4, "items": {"type": "string"}},
    "meta": {"type": "object", "properties": {"source": {"type": "string"}}},
    "price": {"type": "number", "minimum": 0}
  }
}
